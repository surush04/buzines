generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DirectiveStatus {
  RECEIVED
  ANALYZING
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_OWNER
  MANAGER
  TEAM_LEAD
  EMPLOYEE
  HR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_VACATION
  SICK_LEAVE
  TERMINATED
}

enum ExperienceLevel {
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  PRINCIPAL
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskCategory {
  FRONTEND
  BACKEND
  DESIGN
  DATABASE
  DEVOPS
  TESTING
  DOCUMENTATION
  OTHER
}

enum TaskResponseType {
  ACCEPTED
  STARTED
  COMPLETED
  BLOCKED
  NEED_HELP
  RUNNING_LATE
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
  WHATSAPP
  SMS
}

enum NotificationType {
  MORNING_BRIEFING
  TASK_ASSIGNMENT
  REMINDER
  DEADLINE_WARNING
  MANAGER_MESSAGE
  CONGRATULATIONS
  PERFORMANCE_REPORT
  BLOCKER_ALERT
  ESCALATION
  AI_RECOMMENDATION
}

enum AiAutonomyLevel {
  OBSERVER
  ADVISOR
  GUIDED_AUTONOMY
  FULL_AUTONOMY
}

enum AiPersonality {
  PROFESSIONAL
  FRIENDLY
  DIRECT
  SUPPORTIVE
}

enum CalendarEventType {
  MEETING
  DEADLINE
  VACATION
  BIRTHDAY
  COMPANY_EVENT
  REMINDER
}

enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  role             UserRole  @default(EMPLOYEE)
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  avatarUrl        String?   @map("avatar_url")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  ownedCompanies Company[] @relation("CompanyOwner")
  employeeProfile Employee?
  sentMessages    Message[] @relation("MessageSender")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Company & Organization ──────────────────────────────────────────────────

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  industry    String?
  businessType String? @map("business_type")
  teamSize    Int?     @map("team_size")
  onboardingDone Boolean @default(false) @map("onboarding_done")
  timezone    String   @default("UTC")
  logoUrl     String?  @map("logo_url")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner        User              @relation("CompanyOwner", fields: [ownerId], references: [id])
  departments  Department[]
  employees    Employee[]
  projects     Project[]
  settings     CompanySettings?
  aiSettings   AiSettings?
  integrations Integration[]
  calendarEvents CalendarEvent[]
  reports      Report[]
  aiRecommendations AiRecommendation[]
  directives   AdminDirective[]

  @@map("companies")
}

model CompanySettings {
  id                    String   @id @default(uuid())
  companyId             String   @unique @map("company_id")
  workingHoursStart     String   @default("09:00") @map("working_hours_start")
  workingHoursEnd       String   @default("18:00") @map("working_hours_end")
  workingDays           Json     @default("[1,2,3,4,5]") @map("working_days")
  dailyPlanTime         String   @default("07:30") @map("daily_plan_time")
  reminderIntervalMin   Int      @default(120) @map("reminder_interval_min")
  followUpIntervalMin   Int      @default(60) @map("follow_up_interval_min")
  language              String   @default("en")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model AiSettings {
  id              String          @id @default(uuid())
  companyId       String          @unique @map("company_id")
  autonomyLevel   AiAutonomyLevel @default(ADVISOR) @map("autonomy_level")
  personality     AiPersonality   @default(PROFESSIONAL)
  customPrompt    String?         @map("custom_prompt")
  businessContext String?         @map("business_context")
  enableAutoAssign Boolean        @default(true) @map("enable_auto_assign")
  enableAutoEscalate Boolean      @default(true) @map("enable_auto_escalate")
  enableSmartAnalysis Boolean     @default(true) @map("enable_smart_analysis")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  managerId   String?  @map("manager_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DepartmentEmployees")
  projects  Project[]

  @@unique([companyId, name])
  @@map("departments")
}

// ─── Employees ───────────────────────────────────────────────────────────────

model Employee {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  departmentId     String?         @map("department_id")
  userId           String?         @unique @map("user_id")
  managerId        String?         @map("manager_id")
  firstName        String          @map("first_name")
  lastName         String          @map("last_name")
  email            String
  phone            String?
  telegramUsername String?         @map("telegram_username")
  telegramChatId   String?         @map("telegram_chat_id")
  telegramLinkCode String?         @unique @map("telegram_link_code")
  whatsappNumber   String?         @map("whatsapp_number")
  photoUrl         String?         @map("photo_url")
  role             String
  experienceLevel  ExperienceLevel @default(MIDDLE) @map("experience_level")
  status           EmployeeStatus  @default(ACTIVE)
  workingHoursStart String?        @map("working_hours_start")
  workingHoursEnd  String?         @map("working_hours_end")
  vacationStart    DateTime?       @map("vacation_start")
  vacationEnd      DateTime?       @map("vacation_end")
  isOnline         Boolean         @default(false) @map("is_online")
  lastActiveAt     DateTime?       @map("last_active_at")
  hiredAt          DateTime?       @map("hired_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?       @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  manager      Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]       @relation("EmployeeManager")
  managedDepartments Department[] @relation("DepartmentManager")
  skills       EmployeeSkill[]
  aiProfile    EmployeeAiProfile?
  taskAssignments TaskAssignment[]
  dailyPlans   DailyPlan[]
  taskResponses TaskResponse[]
  messages     Message[]
  notifications Notification[]
  performanceMetrics PerformanceMetric[]

  @@unique([companyId, email])
  @@map("employees")
}

model EmployeeSkill {
  id         String @id @default(uuid())
  employeeId String @map("employee_id")
  name       String
  level      Int    @default(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, name])
  @@map("employee_skills")
}

model EmployeeAiProfile {
  id                    String   @id @default(uuid())
  employeeId            String   @unique @map("employee_id")
  avgCompletionTimeMin  Float?   @map("avg_completion_time_min")
  taskCompletionRate    Float?   @map("task_completion_rate")
  onTimeRate            Float?   @map("on_time_rate")
  peakProductivityHours Json     @default("[]") @map("peak_productivity_hours")
  commonBlockers        Json     @default("[]") @map("common_blockers")
  strengths             Json     @default("[]")
  weaknesses            Json     @default("[]")
  productivityScore     Float    @default(0) @map("productivity_score")
  responseTimeAvgMin    Float?   @map("response_time_avg_min")
  aiNotes               String?  @map("ai_notes")
  lastAnalyzedAt        DateTime? @map("last_analyzed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_ai_profiles")
}

// ─── Projects & Tasks ────────────────────────────────────────────────────────

model Project {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  departmentId String?        @map("department_id")
  name        String
  description String?
  deadline    DateTime
  priority    ProjectPriority @default(MEDIUM)
  status      ProjectStatus   @default(PLANNING)
  progress    Float           @default(0)
  healthScore Float           @default(100) @map("health_score")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  tasks      Task[]
  directives AdminDirective[]

  @@map("projects")
}

model Task {
  id              String       @id @default(uuid())
  projectId       String       @map("project_id")
  parentTaskId    String?      @map("parent_task_id")
  title           String
  description     String?
  category        TaskCategory @default(OTHER)
  status          TaskStatus   @default(PENDING)
  priority        ProjectPriority @default(MEDIUM)
  estimatedHours  Float?       @map("estimated_hours")
  actualHours     Float?       @map("actual_hours")
  deadline        DateTime?
  completedAt     DateTime?    @map("completed_at")
  aiGenerated     Boolean      @default(false) @map("ai_generated")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask   Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks     Task[]           @relation("TaskHierarchy")
  assignments  TaskAssignment[]
  responses    TaskResponse[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("BlockingTask")
  dailyPlanTasks DailyPlanTask[]

  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String @map("task_id")
  dependsOnTaskId String @map("depends_on_task_id")

  task          Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskAssignment {
  id          String     @id @default(uuid())
  taskId      String     @map("task_id")
  employeeId  String     @map("employee_id")
  assignedAt  DateTime   @default(now()) @map("assigned_at")
  assignedBy  String     @default("AI") @map("assigned_by")
  status      TaskStatus @default(ASSIGNED)
  completedAt DateTime?  @map("completed_at")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@map("task_assignments")
}

model TaskResponse {
  id           String           @id @default(uuid())
  taskId       String           @map("task_id")
  employeeId   String           @map("employee_id")
  responseType TaskResponseType @map("response_type")
  message      String?
  progressPct  Int?             @map("progress_pct")
  aiAnalysis   String?          @map("ai_analysis")
  createdAt    DateTime         @default(now()) @map("created_at")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("task_responses")
}

// ─── Daily Plans ─────────────────────────────────────────────────────────────

model DailyPlan {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  planDate   DateTime @map("plan_date")
  message    String?
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    DailyPlanTask[]

  @@unique([employeeId, planDate])
  @@map("daily_plans")
}

model DailyPlanTask {
  id          String    @id @default(uuid())
  dailyPlanId String    @map("daily_plan_id")
  taskId      String    @map("task_id")
  sortOrder   Int       @default(0) @map("sort_order")
  deadline    DateTime?
  status      TaskStatus @default(ASSIGNED)

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("daily_plan_tasks")
}

// ─── Communication ───────────────────────────────────────────────────────────

model Message {
  id          String           @id @default(uuid())
  employeeId  String?          @map("employee_id")
  senderId    String?          @map("sender_id")
  direction   MessageDirection
  channel     NotificationChannel
  content     String
  isFromAi    Boolean          @default(false) @map("is_from_ai")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sender   User?     @relation("MessageSender", fields: [senderId], references: [id])

  @@map("messages")
}

model Notification {
  id        String              @id @default(uuid())
  employeeId String             @map("employee_id")
  type      NotificationType
  channel   NotificationChannel
  title     String
  content   String
  isRead    Boolean             @default(false) @map("is_read")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Integration {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  type        String
  config      Json
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@map("integrations")
}

// ─── Analytics & Reports ─────────────────────────────────────────────────────

model PerformanceMetric {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  date            DateTime
  tasksCompleted  Int      @default(0) @map("tasks_completed")
  tasksAssigned   Int      @default(0) @map("tasks_assigned")
  hoursWorked     Float    @default(0) @map("hours_worked")
  productivityScore Float  @default(0) @map("productivity_score")
  onTimeRate      Float    @default(0) @map("on_time_rate")
  responseTimeMin Float?   @map("response_time_min")
  createdAt       DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("performance_metrics")
}

model Report {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  period    ReportPeriod
  title     String
  content   Json
  aiSummary String?      @map("ai_summary")
  startDate DateTime     @map("start_date")
  endDate   DateTime     @map("end_date")
  createdAt DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model AiRecommendation {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  type        String
  title       String
  description String
  impact      String?
  isAccepted  Boolean? @map("is_accepted")
  isDismissed Boolean  @default(false) @map("is_dismissed")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

// ─── Calendar ────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  title       String
  description String?
  type        CalendarEventType
  startAt     DateTime          @map("start_at")
  endAt       DateTime?         @map("end_at")
  allDay      Boolean           @default(false) @map("all_day")
  employeeId  String?           @map("employee_id")
  projectId   String?           @map("project_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// ─── Admin Directives (Owner gives order → AI executes) ─────────────────────

model AdminDirective {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  instruction String
  aiAnalysis  String?         @map("ai_analysis")
  status      DirectiveStatus @default(RECEIVED)
  progress    Float           @default(0)
  projectId   String?         @map("project_id")
  tasksTotal  Int             @default(0) @map("tasks_total")
  tasksDone   Int             @default(0) @map("tasks_done")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@map("admin_directives")
}
