# PostgreSQL. Local development uses the database from docker-compose.yml.
DATABASE_URL="postgresql://abm:abm_secret@localhost:5432/ai_business_manager?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRATION="24h"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
JWT_REFRESH_EXPIRATION="7d"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MODEL_FAST="llama-3.3-70b-versatile"
AI_PROVIDER="groq"

PORT=3000
NODE_ENV=development

# Public Angular origin (Vercel URL). Required for CORS when friends use the site.
FRONTEND_URL="http://localhost:4201"
# Extra allowed origins, comma-separated (custom domains).
CORS_ORIGINS=""

DAILY_PLAN_CRON="30 7 * * *"
FOLLOW_UP_CRON="0 */2 * * *"
