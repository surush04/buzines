{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": ["npm ci"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "node scripts/patch-env.mjs",
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist/frontend/browser -l ${PORT:-8080}"
  }
}
